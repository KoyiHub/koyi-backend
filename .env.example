# Copy to .env and adjust: `cp .env.example .env`
# .env is git-ignored and is for LOCAL DEVELOPMENT ONLY.
# In deployed environments, inject these as real environment variables.

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
# Generate one with: make secret
DJANGO_SECRET_KEY=django-insecure-local-only-do-not-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
# verbose (human-readable) or json
DJANGO_LOG_FORMAT=verbose

# --- Database ---------------------------------------------------------------
# SQLite by default. To use Postgres instead, uncomment the second line:
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://koyi:koyi@localhost:5432/koyi

# --- Cache ------------------------------------------------------------------
CACHE_URL=locmemcache://
# CACHE_URL=redis://localhost:6379/1

# --- Celery -----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
# Set True to run tasks inline (no worker or Redis needed at all).
CELERY_TASK_ALWAYS_EAGER=False

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- API --------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=1000/hour

# --- Email ------------------------------------------------------------------
DJANGO_DEFAULT_FROM_EMAIL=no-reply@koyi.local
